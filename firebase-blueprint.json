{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account containing identity and assigned operational role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "lgId": { "type": "string" },
        "lgName": { "type": "string" },
        "state": { "type": "string" },
        "role": {
          "type": "string",
          "enum": [
            "CDS_COORDINATOR",
            "STATE_PRESIDENT",
            "VP_GROWTH",
            "VP_ACCOUNTABILITY",
            "VP_COMMUNITY_IMPACT",
            "LG_PRESIDENT",
            "EXECUTIVE",
            "GROUP_LEADER",
            "MEMBER"
          ]
        },
        "membershipStatus": {
          "type": "string",
          "enum": ["ACTIVE", "INACTIVE", "PENDING"]
        },
        "stateCode": { "type": "string" },
        "callUpNo": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "lgId", "role", "membershipStatus", "createdAt", "updatedAt", "createdBy"]
    },
    "UserProfilePublic": {
      "title": "UserProfilePublic",
      "description": "Non-sensitive user directory profile visible to members of the same chapter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "lgId": { "type": "string" },
        "lgName": { "type": "string" },
        "role": { "type": "string" },
        "membershipStatus": { "type": "string" },
        "profilePhoto": { "type": "string" }
      },
      "required": ["id", "fullName", "lgId", "role", "membershipStatus"]
    },
    "LocalGovernment": {
      "title": "LocalGovernment",
      "description": "Local Government area chapter of DO-DEEL CDS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "presidentId": { "type": "string" },
        "presidentName": { "type": "string" },
        "meetingVenue": { "type": "string" },
        "meetingDay": { "type": "string" },
        "activeMemberCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "name", "state", "createdAt", "updatedAt", "createdBy"]
    },
    "Task": {
      "title": "Task",
      "description": "Responsibility or KPI task assigned within DO-DEEL CDS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "assignedToRole": { "type": "string" },
        "assignedBy": { "type": "string" },
        "assignedByName": { "type": "string" },
        "assignedLG": { "type": "string" },
        "assignedLGName": { "type": "string" },
        "team": { "type": "string" },
        "kpi": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "startDate": { "type": "string" },
        "deadline": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "OVERDUE"]
        },
        "manualProgress": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"]
        },
        "completedAt": { "type": "string" },
        "result": { "type": "string" },
        "hasEvidence": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "description", "assignedTo", "assignedBy", "assignedLG", "kpi", "priority", "deadline", "manualProgress", "createdAt", "updatedAt", "createdBy"]
    },
    "TaskUpdate": {
      "title": "TaskUpdate",
      "description": "Progress note, status change or review comment on a task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "taskId", "authorId", "authorName", "text", "createdAt", "updatedAt", "createdBy"]
    },
    "Evidence": {
      "title": "Evidence",
      "description": "Documented proof of task or activity execution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["IMAGE", "PDF", "DOCUMENT", "URL", "SOCIAL_URL", "DESCRIPTION"]
        },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedByName": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "taskId", "type", "description", "submittedBy", "submittedAt", "createdAt", "updatedAt", "createdBy"]
    },
    "Activity": {
      "title": "Activity",
      "description": "CDS meeting, workshop, webinar, or community outreach project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "locationType": {
          "type": "string",
          "enum": ["IN_PERSON", "ONLINE"]
        },
        "location": { "type": "string" },
        "lgId": { "type": "string" },
        "lgName": { "type": "string" },
        "organizerId": { "type": "string" },
        "organizerName": { "type": "string" },
        "organizerRole": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["UPCOMING", "COMPLETED", "CANCELLED"]
        },
        "expectedAttendance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "description", "date", "time", "locationType", "location", "lgId", "organizerId", "status", "createdAt", "updatedAt", "createdBy"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Member attendance record for an activity, keyed by memberId to prevent duplicates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "activityId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "lgId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PRESENT", "ABSENT"]
        },
        "markedBy": { "type": "string" },
        "markedByName": { "type": "string" },
        "markedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "activityId", "memberId", "status", "markedBy", "markedAt", "createdAt", "updatedAt", "createdBy"]
    },
    "Document": {
      "title": "Document",
      "description": "Official CDS document or guide with access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "Governance",
            "Executive Resources",
            "Training Materials",
            "Programme Guides",
            "Reports & Templates",
            "Forms",
            "Branding",
            "Other"
          ]
        },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileType": { "type": "string" },
        "visibility": {
          "type": "string",
          "enum": ["ALL", "EXECUTIVES_ONLY", "LEADERSHIP_ONLY"]
        },
        "version": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "description", "category", "fileUrl", "visibility", "uploadedBy", "createdAt", "updatedAt", "createdBy"]
    },
    "LearningResource": {
      "title": "LearningResource",
      "description": "Educational resource (YouTube video, PDF handbook, or external tutorial)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["YOUTUBE", "PDF", "EXTERNAL_URL"]
        },
        "url": { "type": "string" },
        "youtubeVideoId": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "Digital Literacy",
            "Employability",
            "Entrepreneurship",
            "Leadership",
            "Digital Marketing",
            "Web Development",
            "Data Analysis",
            "Community Impact",
            "Other"
          ]
        },
        "durationOrPages": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PUBLISHED", "DRAFT", "ARCHIVED"]
        },
        "publishedBy": { "type": "string" },
        "publisherName": { "type": "string" },
        "publisherRole": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "description", "type", "url", "category", "status", "publishedBy", "publishedAt", "createdAt", "updatedAt", "createdBy"]
    },
    "MonthlyReport": {
      "title": "MonthlyReport",
      "description": "Standard 8-section monthly operations and impact report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportingMonth": { "type": "string" },
        "year": { "type": "number" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "lgId": { "type": "string" },
        "lgName": { "type": "string" },
        "state": { "type": "string" },
        "activitiesAssigned": { "type": "number" },
        "activitiesCompleted": { "type": "number" },
        "evidence": { "type": "string" },
        "results": { "type": "string" },
        "beneficiaries": { "type": "number" },
        "challenges": { "type": "string" },
        "outstandingTasks": { "type": "string" },
        "nextMonthPlan": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["SUBMITTED", "REVIEWED"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "reportingMonth", "userId", "lgId", "results", "status", "createdAt", "updatedAt", "createdBy"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official broadcast announcement for state or LG members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "targetLG": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["NORMAL", "URGENT"]
        },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "content", "targetLG", "priority", "authorId", "createdAt", "updatedAt", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user records with PII, restricted to account owner and leadership"
    },
    "/user_profiles/{userId}": {
      "schema": "UserProfilePublic",
      "description": "Public directory profile with non-sensitive fields"
    },
    "/lgs/{lgId}": {
      "schema": "LocalGovernment",
      "description": "Local Government chapters"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Responsibilities and KPI assignments"
    },
    "/tasks/{taskId}/task_updates/{updateId}": {
      "schema": "TaskUpdate",
      "description": "Comments and execution status updates for a task"
    },
    "/tasks/{taskId}/evidence/{evidenceId}": {
      "schema": "Evidence",
      "description": "Evidence deliverables submitted for a task"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "CDS activities, workshops and meetings"
    },
    "/activities/{activityId}/attendance/{memberId}": {
      "schema": "Attendance",
      "description": "Attendance record for an activity keyed by memberId"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "CDS documents and guides"
    },
    "/learning_resources/{resourceId}": {
      "schema": "LearningResource",
      "description": "Curated YouTube videos, PDFs and learning materials"
    },
    "/monthly_reports/{reportId}": {
      "schema": "MonthlyReport",
      "description": "8-part monthly operational reports"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Broadcast announcements"
    }
  }
}
